# 플럭스랩스 홈페이지 환경변수 예시
#
# 이 파일을 .env.local 로 복사해서 값을 채운다.
# .env.local 은 .gitignore 에 있으므로 커밋되지 않는다.
#
# ⚠️ 보안 체크리스트 B-5
#    아래 값 중 NEXT_PUBLIC_ 접두사가 없는 것은 **절대 붙이지 말 것.**
#    붙이는 순간 브라우저 번들에 그대로 들어가 누구나 볼 수 있다.


# ── 메일 발송 (문의 폼) ──────────────────────────────────────────────
# 발송 수단. 현재 지원: smtp
MAIL_TRANSPORT=smtp

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# 발신 주소. 수신 도메인의 SPF/DKIM 정렬을 위해 회사 도메인 주소를 쓴다
SMTP_FROM="플럭스랩스 홈페이지 <no-reply@fluxlabs.co.kr>"

# ⚠️ 문의 수신 주소. 보안 체크리스트 B-2 —
#    이 값은 반드시 서버 환경변수로만 지정한다. 요청 본문에서 받으면
#    폼이 스팸 릴레이가 된다.
CONTACT_TO_EMAIL=info@fluxlabs.co.kr


# ── Slack 알림 (선택) ───────────────────────────────────────────────
# 비워 두면 알림을 보내지 않는다. 메일 발송에는 영향 없음.
SLACK_WEBHOOK_URL=


# ── 검색엔진 소유권 확인 (기획서 7.4) ───────────────────────────────
# 공개되어도 무방한 값이라 NEXT_PUBLIC_ 접두사가 맞다.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=


# ── 카카오맵 (오시는 길) ────────────────────────────────────────────
# 발급: https://developers.kakao.com → 내 애플리케이션 → 앱 키 → JavaScript 키
#
# JS 키는 원래 브라우저에 노출되는 종류라 NEXT_PUBLIC_ 이 맞다.
# ⚠️ 단, 카카오 개발자 콘솔의 [앱 설정 → 플랫폼 → Web] 에
#    **사이트 도메인을 반드시 등록**할 것 (보안 체크리스트 B-5).
#    등록하지 않으면 키를 복사해 간 누구나 우리 쿼터를 쓴다.
#    등록 대상: https://fluxlabs.co.kr · http://localhost:3000 (개발용)
#
# 비워 두면 지도를 로드하지 않고 카카오맵 외부 링크로 폴백한다.
NEXT_PUBLIC_KAKAO_MAP_KEY=
